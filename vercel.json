{
  "rewrites": [{ "source": "/", "destination": "/site/index.html" }],
  "headers": [
    { "source": "/scripts/(.*)", "headers": [{ "key": "Content-Type", "value": "text/javascript; charset=utf-8" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ]
}
